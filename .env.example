# Copy to `.env` (gitignored) and fill in before running the full container stack:
#   docker compose --profile full up --build
#
# These values are injected into the `backend` container (see docker-compose.yml).

# Connection string targets the `postgres` service on the compose network.
# The password must match POSTGRES_PASSWORD in docker-compose.yml (dev_password).
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=commonground_dev;Username=commonground;Password=dev_password

# Session JWT signing key and private-token HMAC key. Dev-only values are fine here,
# but generate strong, unique secrets per environment — e.g. `openssl rand -base64 48`.
# Never reuse these in production.
Jwt__SecretKey=replace-with-a-long-random-dev-secret-at-least-32-bytes
Privacy__HmacKey=replace-with-a-long-random-dev-hmac-key
